# Required only for --live (Amazon Bedrock). The default demo is offline.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# Optional Bedrock model id. Default matches the Strands Python quickstart.
AGENCY_OPS_MODEL=global.anthropic.claude-sonnet-4-6

# Where the agent writes logs, drafts, reminders, and gated actions.
AGENCY_OPS_DATA_DIR=data
